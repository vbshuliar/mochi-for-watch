{
  "name": "mochi-for-watch-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "setup": "node scripts/setup.mjs",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "oauth": "node --env-file-if-exists=.env scripts/oauth.mjs",
    "voice": "node --env-file-if-exists=.env scripts/voice.mjs",
    "chat": "node --env-file-if-exists=.env scripts/chat.mjs",
    "format": "prettier --write src test scripts",
    "format:check": "prettier --check src test scripts",
    "check": "npm run format:check && npm run typecheck && npm run build && npm test",
    "check:preview": "node --test ../preview/emulator/*.test.mjs && node ../preview/animation/check.cjs",
    "check:all": "npm run check && npm run check:preview && sh ../native/scripts/check-core.sh",
    "emulator": "node --env-file-if-exists=.env scripts/emulator-server.mjs",
    "website:stage": "node scripts/stage-website.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
