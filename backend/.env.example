# npm run setup creates unique local credentials; never commit .env.
HOST=127.0.0.1
PORT=8787
APP_MODE=mock
API_TOKEN=
ENCRYPTION_KEY=
DATABASE_PATH=./data/muse.sqlite
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=low
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/oauth/google/callback

# ElevenLabs speech output (optional; Jessica only; failures keep replies as text)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_MODEL=eleven_flash_v2_5

# Gmail uses the Google OAuth app above, with a separate read-only grant.
GMAIL_REDIRECT_URI=http://127.0.0.1:8787/oauth/gmail/callback
# Notion public OAuth connection (server-side credentials only).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://127.0.0.1:8787/oauth/notion/callback

# Outbound booking calls: leave empty until a consented test destination is ready.
# Public HTTPS origin only, no path/query. Routes /webhooks/calls/* and /call-audio/*
# must reach this backend. Never expose API_TOKEN in these URLs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ALLOWED_NUMBERS=
CALLS_PUBLIC_URL=

# Facebook Login for Instagram professional accounts and Facebook Pages.
# Register /oauth/instagram/callback and /oauth/facebook/callback on this base.
META_SOCIAL_APP_ID=
META_SOCIAL_APP_SECRET=
META_SOCIAL_REDIRECT_BASE=http://127.0.0.1:8787
GRAPH_API_VERSION=v24.0
